/*
   РЕПЛИКАЦИЯ И ШАРДИРОВАНИЕ

  -----------PostgreSQL (users, posts, hashtags, post_hashtags,
             comments, dialogs, dialog_participants,
             dialog_read_state, media)-------------

  Репликация: master-slave/master-replica.
    - Запись — в master, чтение — с реплик (read:write сильно
      перекошен в сторону чтения для всех этих таблиц).
    - Асинхронная репликация,
      цена потери последних миллисекунд несинхронизированных данных
      низкая, посты и комментарии можно перепостить.

  Шардирование: hash-based по user_id.
    - users, posts (author_id), comments (author_id), media (owner_id)
      шардируются одной и той же хэш-функцией от user_id, физически
      лежат на одном шарде, запрос "профиль + его посты" не требует
      cross-shard JOIN.
    - Hash-based выбран вместо range-based, т.к. user_id — UUID без
      естественного порядка.

  ---------- Cassandra (messages) ----------

  Репликация: masterless.
    N=3, W=1, R=1 — максимальная доступность. Недоступность
    чата критична, задержка репликации отдельного сообщения на доли
    секунды - нет.

  Шардирование: partition key = (dialog_id, time_bucket), clustering key = created_at.
    - time_bucket (например, месяц) разбивает один логический диалог
      на несколько физических партиций во времени.
    - Бакет выбран временным, а не случайным: сообщения внутри
      каждого бакета остаются физически отсортированными по
      created_at — чтение "последние N сообщений" не требует
      сортировки на стороне приложения.

  ---------- Graph DB (relationships) ----------

  Репликация: leader-follower. Запись
  (создание/удаление рёбер FRIEND/FOLLOWS/ROMANTIC) — на leader,
  чтение (обходы, рекомендации друзей) — с follower.
*/

==============Анкеты===============

Table users {
  id              uuid        [pk]
  first_name      text        [not null]
  last_name       text        [not null]
  bio             text
  city            text
  interests       text[]      [not null, default: '{}']
  avatar_media_id uuid        [ref: > media.id]
  created_at      timestamp   [not null, default: `now()`]
}

==============Посты===============

Table posts {
  id          uuid        [pk]
  author_id   uuid        [not null, ref: > users.id]
  text        text        [not null]
  media_ids   uuid[]      [not null, default: '{}']
  likes_count bigint      [not null, default: 0]
  views_count bigint      [not null, default: 0]
  created_at  timestamp   [not null, default: `now()`]
}

Table hashtags {
  id  uuid [pk]
  tag text [not null, unique]
}

Table post_hashtags {
  post_id    uuid        [not null, ref: > posts.id]
  hashtag_id uuid        [not null, ref: > hashtags.id]
  created_at timestamp   [not null]
}

Table comments {
  id         uuid        [pk]
  post_id    uuid        [not null, ref: > posts.id]
  author_id  uuid        [not null, ref: > users.id]
  text       text        [not null]
  created_at timestamp   [not null, default: `now()`]
}

==============Сообщения и чаты===============

Table dialogs {
  id         uuid        [pk]
  type       text        [not null]
  title      text
  created_at timestamp   [not null, default: `now()`]
}

Table dialog_participants {
  dialog_id uuid [not null, ref: > dialogs.id]
  user_id   uuid [not null, ref: > users.id]
}

Table messages {
  dialog_id   uuid      [ref: > dialogs.id]
  time_bucket text
  created_at  timestamp
  id          uuid
  sender_id   uuid      [ref: > users.id]
  text        text
  media_ids   uuid[]

  Note: 'Wide-column БДшка, например Cassandra'
}

Table dialog_read_state {
  dialog_id            uuid [not null, ref: > dialogs.id]
  user_id              uuid [not null, ref: > users.id]
  last_read_message_id uuid [not null]
}

==============Отношения===============

Table relationships {
  id         uuid [pk]
  user_a_id  uuid [ref: > users.id]
  user_b_id  uuid [ref: > users.id]
  type       text [not null]
  status     text [not null]
  created_at timestamp [not null, default: `now()`]

  Note: 'Графовая БД, например Neo4j'
}

==============Медиа===============

Table media {
  id         uuid        [pk]
  owner_id   uuid        [not null, ref: > users.id]
  type       text        [not null]
  url        text        [not null]
  status     text        [not null, default: 'pending']
  created_at timestamp   [not null, default: `now()`]
}